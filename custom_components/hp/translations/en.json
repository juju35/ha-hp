{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "HP printer",
        "description": "Enter the address of the printer. Give it a fixed IP address in your router.",
        "data": {
          "host": "Host",
          "port": "Port",
          "ssl": "Use HTTPS"
        },
        "data_description": {
          "host": "IP address or hostname of the printer, for example 192.168.1.12.",
          "port": "Leave empty for the default port (80, or 443 with HTTPS).",
          "ssl": "Only for printers whose web server answers over HTTPS only."
        }
      },
      "zeroconf_confirm": {
        "title": "HP printer found",
        "description": "Add {name} ({host})?"
      },
      "reconfigure": {
        "title": "Change the printer address",
        "description": "The printer must be on to check its new address.",
        "data": {
          "host": "Host",
          "port": "Port",
          "ssl": "Use HTTPS"
        },
        "data_description": {
          "host": "IP address or hostname of the printer, for example 192.168.1.12.",
          "port": "Leave empty for the default port (80, or 443 with HTTPS).",
          "ssl": "Only for printers whose web server answers over HTTPS only."
        }
      }
    },
    "error": {
      "cannot_connect": "The printer does not answer. Check that it is on and that its address is correct."
    },
    "abort": {
      "already_configured": "This printer is already configured.",
      "cannot_connect": "The printer does not answer.",
      "missing_serial_number": "The printer does not report a serial number: it cannot be added.",
      "wrong_printer": "Another printer answers at this address.",
      "reconfigure_successful": "The printer address was updated."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Options",
        "data": {
          "scan_interval": "Status refresh interval",
          "scan_retention": "Keep scans not downloaded"
        },
        "data_description": {
          "scan_interval": "How often the status is read, in seconds. Page counters and ink levels are read every 5 minutes and after each job.",
          "scan_retention": "Minutes before a scan file that was not downloaded is deleted (a downloaded file is deleted at once). 0 keeps them."
        }
      }
    }
  },
