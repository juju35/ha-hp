  "services": {
    "scan": {
      "name": "Scan",
      "description": "Scans a document from the printer's glass or document feeder and saves it as a PDF or JPEG file. Settings not given are those of the printer's scan select entities.",
      "fields": {
        "device_id": {
          "name": "Printer",
          "description": "The printer to scan with. Optional when only one is set up."
        },
        "format": {
          "name": "Format",
          "description": "PDF (one file with every page) or JPEG (one image per page)."
        },
        "source": {
          "name": "Source",
          "description": "Glass or document feeder."
        },
        "resolution": {
          "name": "Resolution",
          "description": "Dots per inch. 300 suits documents."
        },
        "color_mode": {
          "name": "Color mode",
          "description": "Color, grayscale or black and white."
        },
        "page_size": {
          "name": "Page size",
          "description": "Area scanned. Whole glass scans the largest area of the source."
        },
        "directory": {
          "name": "Folder",
          "description": "Where the files are saved. Default: the hp folder of the local media. It must be in allowlist_external_dirs."
        },
        "filename": {
          "name": "File name",
          "description": "Without extension. Default: scan_ followed by the date and time."
        },
        "append": {
          "name": "Add to the last PDF",
          "description": "Scan one more page and add it to the last PDF scanned, instead of starting a new file: for a document scanned page by page on the glass."
        }
      }
    }
  },
